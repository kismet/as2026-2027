# Project: insiemiListe
# Makefile created by Red Panda C++ 3.4.3279

CXX      = "g++.exe"
CC       = "gcc.exe"
WINDRES  = "windres.exe"
RM       = del /q /f
CD       = cd /d
LIBS     = "-Wl,--stack,12582912"
INCS     = 
CXXINCS  = 
CXXFLAGS = $(CXXINCS) "-g3" "-fno-ms-extensions" "-pipe" "-Wall" "-Werror=return-type" "-Werror=vla" "-D_DEBUG"
CFLAGS   = $(INCS) "-g3" "-fno-ms-extensions" "-pipe" "-Wall" "-Werror=implicit-int" "-Werror=return-type" "-Werror=vla" "-D_DEBUG"
NASM_FLAGS   =  "-f" "elf64" "-g"
WINDRESFLAGS = 
RES      = insiemiListe_private.res
OBJ      = main.o funzioni.o $(RES)
BIN      = insiemiListe.exe
LINKOBJ  = "main.o" "funzioni.o" "insiemiListe_private.res"
CLEANOBJ = "main.o" "funzioni.o" "insiemiListe_private.res" "insiemiListe.exe"

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	-$(RM) $(CLEANOBJ) >NUL 2>&1

insiemiListe.exe: $(OBJ)

	$(CXX) $(LINKOBJ) -o "insiemiListe.exe" $(LIBS)

main.o: main.cpp funzioni.h types.h
	$(CXX) -c "main.cpp" -o "main.o" $(CXXFLAGS) 

funzioni.o: funzioni.cpp funzioni.h types.h
	$(CXX) -c "funzioni.cpp" -o "funzioni.o" $(CXXFLAGS) 

insiemiListe_private.res: insiemiListe_private.rc 
	$(WINDRES) -i "insiemiListe_private.rc" --input-format=rc -o "insiemiListe_private.res" -O coff $(WINDRESFLAGS) 

